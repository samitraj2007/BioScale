# BioScale monorepo — Next.js frontend + Python/FastAPI/ML backend
# Commit source, configs, models, and small processed data; ignore caches and secrets.

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Environment (never commit secrets; use .env.example instead) ---
.env
.env.local
.env.*.local

# --- Node / Next.js (frontend/) ---
node_modules/
frontend/.next/
frontend/out/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# --- Python bytecode and test caches ---
__pycache__/
*.py[cod]
*.pyo
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments (create locally; do not commit) ---
.venv/
venv/
env/

# --- Python packaging artifacts ---
*.egg-info/
.eggs/
dist/
build/

# --- ML / notebook local artifacts ---
*.ipynb_checkpoints/
.mlflow/

# --- NHANES raw data (large public files; obtain via bioscale/backend/etl/README.md) ---
bioscale/data/raw/**/*.xpt
bioscale/data/raw/**/*.dat
bioscale/data/raw/**/*.sas7bdat

# --- ETL interim outputs (regenerate via pipeline) ---
bioscale/data/interim/

# --- Logs ---
*.log
logs/
