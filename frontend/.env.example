# Base URL of the BioScale FastAPI backend.
# The frontend appends "/predict" and "/health" to this value.
#
# Local development (FastAPI started with: uvicorn backend.api.app:app --reload):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# Production example (replace with your deployed API origin, no trailing slash):
# NEXT_PUBLIC_API_BASE_URL=https://api.bioscale.example.org
